# 各子项目构建产物
**/artifact.zip
**/userapp-next-standalone.zip

# 平台构建整体包（POST /api/userapp/build 产物落 workspace 根 builds/ 子目录）
/builds/

# dev 运行目录（zip 部署解压产物与轮换现场——平台生成勿提交）
/.run/
/.previous/
/.staging/

# app-cli --gen-lock 本地产物（平台构建时在容器内重新生成）
/release.lock.toml

# Node
**/node_modules/
**/dist/
**/.next/

# Go / Rust 二进制产物（勿用 **/server，会误伤 cmd/server/）
backend-go/server
backend-rust/server

# Java
**/*.class
**/target/

# Python
**/__pycache__/
**/deps/

# Rust
**/target/

# 日志
**/logs/

# CLI 脚手架产物
cli/node_modules/
cli/dist/
cli/templates/
cli/docs/

# IDE 会话产物
.zcode/
.qoder/
