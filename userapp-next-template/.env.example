# UserApp Next.js 模板 — 环境变量示例
# 本地开发：复制为 .env.local；UserApp 部署：在 create app 的 env 字段传

# PostgreSQL（容器内 PG，app-runtime-base 镜像内置，supervisor 起 localhost:5432）
# 未注入时的默认凭据为 dev/dev/dev（与 app-runtime-base initdb 一致；用户可自行重置）
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev
POSTGRES_DB=dev
PGHOST=localhost
PGPORT=5432

# 可选：直接用 DATABASE_URL 连接串（设了则优先于上面的 POSTGRES_* / PGHOST / PGPORT）
# 适用：外部 PG / Neon / Supabase
# DATABASE_URL=postgresql://dev:dev@localhost:5432/dev

# Next.js
# NODE_ENV 不在此设置（避免复制成 .env.local 后生产误跑 dev 模式）：
# - 本地开发：`npm run dev` 自动设为 development
# - 生产部署：由 deploy.sh 注入 NODE_ENV=production
